#!/bin/sh

echo '*************************'
echo '* Setting OSX defaults...'
echo '*************************'

# Disable press-and-hold for keys in favor of key repeat.
defaults write -g ApplePressAndHoldEnabled -bool false

# Always open everything in Finder's list view. This is important.
defaults write com.apple.Finder FXPreferredViewStyle Nlsv

# Show the ~/Library folder.
chflags nohidden ~/Library

# Set a really fast key repeat.
defaults write NSGlobalDomain KeyRepeat -int 1

# Set the Finder prefs for showing a few different volumes on the Desktop.
defaults write com.apple.finder ShowExternalHardDrivesOnDesktop -bool true
defaults write com.apple.finder ShowRemovableMediaOnDesktop -bool true

# Disable mouse and scroll acceleration
defaults write .GlobalPreferences com.apple.mouse.scaling -1
defaults write .GlobalPreferences com.apple.scrollwheel.scaling -1

# ScrollFix: enforces fixed N-lines-per-click mouse wheel scrolling.
# macOS's scrollwheel.scaling above doesn't reliably kill acceleration;
# ScrollFix overrides the scroll wheel CGEvents directly.
# Source: https://github.com/flushentitypacket/mac-disable-scroll-accel
if [ ! -d /Applications/ScrollFix.app ]; then
    TMP=$(mktemp -d)
    git clone --depth 1 https://github.com/flushentitypacket/mac-disable-scroll-accel.git "$TMP/scrollfix"
    (cd "$TMP/scrollfix" && ./build.sh)
    cp -R "$TMP/scrollfix/build/ScrollFix.app" /Applications/
    rm -rf "$TMP"
    echo '* ScrollFix installed to /Applications.'
    echo '* Open it once, grant Accessibility permission in System Settings,'
    echo '  then quit and reopen. Add to Login Items to start at boot.'
fi
# Lines scrolled per wheel notch (default 3 if unset)
defaults write local.scrollfix linesPerClick 5
# Disable AppKit smooth-scroll animation (relogin to apply)
defaults write -g NSScrollAnimationEnabled -bool false
defaults write -g AppleScrollAnimationEnabled -bool false

# Traditional scroll direction for trackpad
defaults write -g com.apple.swipescrolldirection -bool false

# Set screenshot dir to ~/Downloads
defaults write com.apple.screencapture location ~/Downloads

# Turn off app bouncing in Dock
defaults write com.apple.dock no-bouncing -bool TRUE
# Autohide Dock
defaults write com.apple.dock autohide -bool true
# Don't show recent apps in Dock
defaults write com.apple.dock "show-recents" -bool "false"

echo '*Done!'
